# 火山引擎 IAM 访问密钥（https://console.volcengine.com/iam/keymanage/）
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# 火山方舟 - 豆包大模型
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_ENDPOINT_ID=

# 火山 RTC - 实时语音对话
RTC_APP_ID=
RTC_APP_KEY=
S2S_APP_ID=
S2S_ACCESS_TOKEN=
RTC_FC_SIGNATURE=nova_fc_secret

# Function Calling 回调地址（公网可达，用 cpolar/ngrok 穿透）
# 火山服务器会 POST 到这个地址通知 function call
VOICE_CALLBACK_URL=

# 视觉理解（摄像头画面 → AI 可感知）
VOICE_VISION_ENABLED=false
VOICE_VISION_INTERVAL=5

# 火山引擎 - 语音识别 ASR（Legacy fallback）
ASR_APP_KEY=
ASR_ACCESS_KEY=
ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel

# 火山引擎 - 语音合成 TTS（Legacy fallback）
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts
TTS_CLUSTER=volcano_tts
TTS_WS_URL=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
